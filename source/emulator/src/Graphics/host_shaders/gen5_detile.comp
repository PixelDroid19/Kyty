#version 450
// Gen5 detile compute kernel. Offset math must stay identical to Tile.cpp:
// TileGetSw64kRxOffset / TileGetStandard64KBOffset / TileGetDepth64KBOffset /
// TileGetStandard4KBOffset. local_size matches TileDetileComputeStyle (8x8).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) buffer DetileBuffer
{
	uint words[];
}
buffers[2];

layout(push_constant) uniform PushConstants
{
	uint width;
	uint height;
	uint pitch_elems;
	uint dst_pitch_elems;
	uint bytes_per_element;
	uint layout_kind; // 0 Sw64kRx, 1 Standard64KB, 2 Standard4KB, 3 Depth64KB32, 4 raw image alias
	uint src_u32_count;
	uint dst_u32_count;
	uint src_byte_offset;
	uint source_width;
	uint source_blocks_x;
	uint destination_blocks_x;
	uint source_first_block;
	uint destination_first_block;
	uint alias_block_count;
}
pc;

uint block_width_64kb(uint bpe)
{
	if (bpe == 1u || bpe == 2u)
	{
		return 256u;
	}
	if (bpe == 4u || bpe == 8u)
	{
		return 128u;
	}
	if (bpe == 16u)
	{
		return 64u;
	}
	return 0u;
}

uint sw64k_rx_within(uint x, uint y, uint bpe)
{
	uint offset = 0u;
	if (bpe == 4u)
	{
		offset ^= (y << 3u) & 0x0008u;
		offset ^= (y << 4u) & 0x0020u;
		offset ^= (y << 5u) & 0x0f80u;
		offset ^= (y << 9u) & 0x1000u;
		offset ^= (y << 8u) & 0x4000u;
		offset ^= (x << 2u) & 0x0004u;
		offset ^= (x << 3u) & 0x0010u;
		offset ^= (x << 4u) & 0x0440u;
		offset ^= (x << 5u) & 0x0300u;
		offset ^= (x << 6u) & 0x0800u;
		offset ^= (x << 9u) & 0xa000u;
		return offset;
	}
	// 8 BPE
	offset ^= (y << 4u) & 0x0010u;
	offset ^= (y << 6u) & 0x0080u;
	offset ^= (y << 5u) & 0x0f00u;
	offset ^= (y << 10u) & 0x5000u;
	offset ^= (x << 3u) & 0x0008u;
	offset ^= (x << 4u) & 0x0460u;
	offset ^= (x << 5u) & 0x0300u;
	offset ^= (x << 6u) & 0x0800u;
	offset ^= (x << 10u) & 0x2000u;
	offset ^= (x << 9u) & 0x8000u;
	return offset;
}

uint sw64k_rx_within_2(uint x, uint y)
{
	uint offset = 0u;
	offset |= (x & 0x7u) << 1u;
	offset |= (y & 0x7u) << 4u;
	offset |= (x & 0x8u) << 4u;
	offset |= ((x ^ y) & 0x8u) << 5u;
	offset |= ((x ^ y) & 0x10u) << 5u;
	offset |= (((x >> 6u) ^ (y >> 5u)) & 1u) << 10u;
	offset |= (((x >> 5u) ^ (y >> 6u)) & 1u) << 11u;
	offset |= (y & 0x10u) << 8u;
	offset |= (x & 0x40u) << 7u;
	offset |= (y & 0x40u) << 8u;
	offset |= (x & 0x80u) << 8u;
	return offset;
}

uvec2 sw64k_rx_coords_4(uint offset)
{
	uint y3 = (offset >> 12u) & 1u;
	uint x4 = (offset >> 13u) & 1u;
	uint x6 = (offset >> 15u) & 1u;
	uint y6 = (offset >> 14u) & 1u;
	uint x = ((offset >> 2u) & 1u) | (((offset >> 4u) & 1u) << 1u) | (((offset >> 6u) & 1u) << 2u) |
	         ((((offset >> 8u) & 1u) ^ y3) << 3u) | (x4 << 4u) |
	         (((((offset >> 11u) & 1u) ^ y6)) << 5u) | (x6 << 6u);
	uint y = ((offset >> 3u) & 1u) | (((offset >> 5u) & 1u) << 1u) | (((offset >> 7u) & 1u) << 2u) |
	         (y3 << 3u) | ((((offset >> 9u) & 1u) ^ x4) << 4u) |
	         ((((offset >> 10u) & 1u) ^ x6) << 5u) | (y6 << 6u);
	return uvec2(x, y);
}

void copy_raw_image_alias(uint word_x, uint y)
{
	uint destination_x = word_x * 2u;
	uint destination_block = (y / 128u) * pc.destination_blocks_x + destination_x / 256u;
	if (destination_block < pc.destination_first_block ||
	    destination_block - pc.destination_first_block >= pc.alias_block_count)
	{
		return;
	}
	uint within = sw64k_rx_within_2(destination_x % 256u, y % 128u);
	uint source_block = pc.source_first_block + destination_block - pc.destination_first_block;
	uvec2 source_local = sw64k_rx_coords_4(within);
	uint source_x = (source_block % pc.source_blocks_x) * 128u + source_local.x;
	uint source_y = (source_block / pc.source_blocks_x) * 128u + source_local.y;
	uint source_word = source_y * pc.source_width + source_x;
	uint destination_word = y * pc.width + word_x;
	if (source_word < pc.src_u32_count && destination_word < pc.dst_u32_count)
	{
		buffers[1].words[destination_word] = buffers[0].words[source_word];
	}
}

uint standard64_within(uint x, uint y, uint bpe)
{
	uint offset = 0u;
	if (bpe == 4u)
	{
		offset ^= (x << 2u) & 0x000cu;
		offset ^= (x << 5u) & 0x0080u;
		offset ^= (x << 6u) & 0x0200u;
		offset ^= (x << 7u) & 0x0800u;
		offset ^= (x << 8u) & 0x2000u;
		offset ^= (x << 9u) & 0x8000u;
		offset ^= (y << 4u) & 0x0070u;
		offset ^= (y << 5u) & 0x0100u;
		offset ^= (y << 6u) & 0x0400u;
		offset ^= (y << 7u) & 0x1000u;
		offset ^= (y << 8u) & 0x4000u;
		return offset;
	}
	if (bpe == 8u)
	{
		offset ^= (x << 3u) & 0x0008u;
		offset ^= (x << 5u) & 0x00c0u;
		offset ^= (x << 6u) & 0x0200u;
		offset ^= (x << 7u) & 0x0800u;
		offset ^= (x << 8u) & 0x2000u;
		offset ^= (x << 9u) & 0x8000u;
		offset ^= (y << 4u) & 0x0030u;
		offset ^= (y << 6u) & 0x0100u;
		offset ^= (y << 7u) & 0x0400u;
		offset ^= (y << 8u) & 0x1000u;
		offset ^= (y << 9u) & 0x4000u;
		return offset;
	}
	if (bpe == 1u)
	{
		offset ^= x & 0x000fu;
		offset ^= (x << 5u) & 0x0200u;
		offset ^= (x << 6u) & 0x0800u;
		offset ^= (x << 7u) & 0x2000u;
		offset ^= (x << 8u) & 0x8000u;
		offset ^= (y << 4u) & 0x01f0u;
		offset ^= (y << 5u) & 0x0400u;
		offset ^= (y << 6u) & 0x1000u;
		offset ^= (y << 7u) & 0x4000u;
		return offset;
	}
	if (bpe == 2u)
	{
		offset ^= (x << 1u) & 0x000eu;
		offset ^= (x << 4u) & 0x0080u;
		offset ^= (x << 5u) & 0x0200u;
		offset ^= (x << 6u) & 0x0800u;
		offset ^= (x << 7u) & 0x2000u;
		offset ^= (x << 8u) & 0x8000u;
		offset ^= (y << 4u) & 0x0070u;
		offset ^= (y << 5u) & 0x0100u;
		offset ^= (y << 6u) & 0x0400u;
		offset ^= (y << 7u) & 0x1000u;
		offset ^= (y << 8u) & 0x4000u;
		return offset;
	}
	// 16 BPE
	offset ^= (x << 6u) & 0x00c0u;
	offset ^= (x << 7u) & 0x0200u;
	offset ^= (x << 8u) & 0x0800u;
	offset ^= (x << 9u) & 0x2000u;
	offset ^= (x << 10u) & 0x8000u;
	offset ^= (y << 4u) & 0x0030u;
	offset ^= (y << 6u) & 0x0100u;
	offset ^= (y << 7u) & 0x0400u;
	offset ^= (y << 8u) & 0x1000u;
	offset ^= (y << 9u) & 0x4000u;
	return offset;
}

uint depth64_within(uint x, uint y, uint bpe)
{
	if (bpe == 2u)
	{
		uint offset = 0u;
		offset ^= (x << 1u) & 0x0002u;
		offset ^= (x << 2u) & 0x0008u;
		offset ^= (x << 3u) & 0x0020u;
		offset ^= (x << 4u) & 0x0480u;
		offset ^= (x << 5u) & 0x0300u;
		offset ^= (x << 6u) & 0x0800u;
		offset ^= (x << 7u) & 0x2000u;
		offset ^= (x << 8u) & 0x8000u;
		offset ^= (y << 2u) & 0x0004u;
		offset ^= (y << 3u) & 0x0010u;
		offset ^= (y << 4u) & 0x0040u;
		offset ^= (y << 5u) & 0x0f00u;
		offset ^= (y << 8u) & 0x5000u;
		return offset;
	}
	uint x_offset = 0u;
	x_offset ^= (x << 2u) & 0x0004u;
	x_offset ^= (x << 3u) & 0x0010u;
	x_offset ^= (x << 4u) & 0x0440u;
	x_offset ^= (x << 5u) & 0x0300u;
	x_offset ^= (x << 6u) & 0x0800u;
	x_offset ^= (x << 9u) & 0xa000u;
	uint y_offset = 0u;
	y_offset ^= (y << 3u) & 0x0008u;
	y_offset ^= (y << 4u) & 0x0020u;
	y_offset ^= (y << 5u) & 0x0f80u;
	y_offset ^= (y << 9u) & 0x1000u;
	y_offset ^= (y << 8u) & 0x4000u;
	return x_offset ^ y_offset;
}

// Tile.cpp Standard4KB32WithinBlockOffset (4 BPE, SW_4K_S).
uint standard4kb_within_4(uint x, uint y)
{
	uint offset = 0u;
	offset ^= (y << 4u) & 0x070u;
	offset ^= (y << 5u) & 0x100u;
	offset ^= (y << 6u) & 0x400u;
	offset ^= (x << 2u) & 0x00cu;
	offset ^= (x << 5u) & 0x080u;
	offset ^= (x << 6u) & 0x200u;
	offset ^= (x << 7u) & 0x800u;
	return offset;
}

uint tiled_byte_offset(uint x, uint y)
{
	uint bpe   = pc.bytes_per_element;
	uint pitch = pc.pitch_elems;
	// 0 = Sw64kRx
	if (pc.layout_kind == 0u)
	{
		uint block_w  = 128u;
		uint block_h  = (bpe == 8u) ? 64u : 128u;
		uint blocks_x = (pitch + block_w - 1u) / block_w;
		uint xb       = x / block_w;
		uint yb       = y / block_h;
		uint blk_idx  = yb * blocks_x + xb;
		return blk_idx * 65536u + sw64k_rx_within(x % block_w, y % block_h, bpe);
	}
	// 1 = Standard64KB
	if (pc.layout_kind == 1u)
	{
		uint block_w  = block_width_64kb(bpe);
		uint block_h  = 65536u / (block_w * bpe);
		uint blocks_x = (pitch + block_w - 1u) / block_w;
		uint xb       = x / block_w;
		uint yb       = y / block_h;
		uint blk_idx  = yb * blocks_x + xb;
		return blk_idx * 65536u + standard64_within(x % block_w, y % block_h, bpe);
	}
	// 3 = Depth64KB (D16 block 256x128, D32 block 128x128)
	if (pc.layout_kind == 3u)
	{
		uint block_w  = (bpe == 2u) ? 256u : 128u;
		uint block_h  = 128u;
		uint blocks_x = pitch / block_w;
		uint xb       = x / block_w;
		uint yb       = y / block_h;
		uint blk_idx  = yb * blocks_x + xb;
		return blk_idx * 65536u + depth64_within(x % block_w, y % block_h, bpe);
	}
	// 2 = Standard4KB, 4 BPE only (block 32x32)
	uint block_w  = 32u;
	uint block_h  = 32u;
	uint blocks_x = (pitch + block_w - 1u) / block_w;
	uint xb       = x / block_w;
	uint yb       = y / block_h;
	uint blk_idx  = yb * blocks_x + xb;
	return blk_idx * 4096u + standard4kb_within_4(x % block_w, y % block_h);
}

void main()
{
	uint x = gl_GlobalInvocationID.x;
	uint y = gl_GlobalInvocationID.y;
	if (x >= pc.width || y >= pc.height)
	{
		return;
	}
	if (pc.layout_kind == 4u)
	{
		copy_raw_image_alias(x, y);
		return;
	}

	uint bpe         = pc.bytes_per_element;
	uint tiled_bytes = pc.src_byte_offset + tiled_byte_offset(x, y);
	uint linear_bytes = (y * pc.dst_pitch_elems + x) * bpe;
	uint tiled_u32    = tiled_bytes / 4u;
	uint linear_u32   = linear_bytes / 4u;
	if (bpe == 2u)
	{
		if (tiled_u32 >= pc.src_u32_count || linear_u32 >= pc.dst_u32_count)
		{
			return;
		}
		uint source_word = buffers[0].words[tiled_u32];
		uint value       = (source_word >> ((tiled_bytes & 2u) * 8u)) & 0xffffu;
		atomicOr(buffers[1].words[linear_u32], value << ((linear_bytes & 2u) * 8u));
		return;
	}
	uint words        = bpe / 4u;
	if (tiled_u32 > pc.src_u32_count || words > pc.src_u32_count - tiled_u32 || linear_u32 > pc.dst_u32_count ||
	    words > pc.dst_u32_count - linear_u32)
	{
		return;
	}
	for (uint i = 0u; i < words; ++i)
	{
		buffers[1].words[linear_u32 + i] = buffers[0].words[tiled_u32 + i];
	}
}
