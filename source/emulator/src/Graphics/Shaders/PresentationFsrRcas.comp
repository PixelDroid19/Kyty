#version 450
#extension GL_GOOGLE_include_directive : require

// Contrast-adaptive sharpening of the upsampled image at the target extent.

#include "PresentationFsrCommon.glsl"

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p)
{
	// RCAS reads the four neighbours: clamp them to the image like an edge sampler.
	const ASU2 last = ASU2(u_parameters.texture_size) - ASU2(1);
	return texelFetch(u_source, clamp(p, ASU2(0), last), 0);
}
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"

void main()
{
	const AU2 position = AU2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(AF2(position), u_parameters.target_size)))
	{
		return;
	}
	AU4 con;
	FsrRcasCon(con, u_parameters.sharpness);
	AF3 color;
	FsrRcasF(color.r, color.g, color.b, position, con);
	StoreTarget(ivec2(position), color);
}
