#version 450
#extension GL_GOOGLE_include_directive : require

// Edge-adaptive spatial upsampling of the presentation source into a target-sized image.

#include "PresentationFsrCommon.glsl"

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return SourceEncoded(textureGather(u_source, p, 0)); }
AF4 FsrEasuGF(AF2 p) { return SourceEncoded(textureGather(u_source, p, 1)); }
AF4 FsrEasuBF(AF2 p) { return SourceEncoded(textureGather(u_source, p, 2)); }
#include "ffx_fsr1.h"

void main()
{
	const AU2 position = AU2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(AF2(position), u_parameters.target_size)))
	{
		return;
	}
	AU4 con0;
	AU4 con1;
	AU4 con2;
	AU4 con3;
	FsrEasuCon(con0, con1, con2, con3, u_parameters.source_size.x, u_parameters.source_size.y, u_parameters.texture_size.x,
	           u_parameters.texture_size.y, u_parameters.target_size.x, u_parameters.target_size.y);
	AF3 color;
	FsrEasuF(color, position, con0, con1, con2, con3);
	StoreTarget(ivec2(position), color);
}
